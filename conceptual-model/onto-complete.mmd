---
title: SIGEVS-O — Complete Ontological Model
---
classDiagram
    %% ═══════════════════════════════════════════
    %% CORE SUBDOMAIN
    %% ═══════════════════════════════════════════
    class Establishment {
        <<Kind>>
    }
    class Address {
        <<Kind>>
    }
    class Person {
        <<Kind>>
    }
    class AnimalSpecies {
        <<Kind>>
    }
    class Slaughterhouse {
        <<Subkind>>
    }
    class SwineFarm {
        <<Subkind>>
    }
    class PoultryFarm {
        <<Subkind>>
    }

    Establishment --> Address : hasAddress
    Establishment --> AnimalSpecies : raises
    Establishment <|-- Slaughterhouse
    Establishment <|-- SwineFarm
    Establishment <|-- PoultryFarm

    %% ═══════════════════════════════════════════
    %% INVESTIGATION SUBDOMAIN
    %% ═══════════════════════════════════════════
    class SanitaryAnalysis {
        <<Event>>
    }
    class InvestigationTarget {
        <<Role>>
    }
    class AffectedArea {
        <<Kind>>
    }
    class ControlZone {
        <<Relator>>
    }
    class AnimalMovement {
        <<Event>>
    }
    class ContactingProperty {
        <<Role>>
    }
    class SpeciesCategory {
        <<Enumeration>>
    }

    SanitaryAnalysis --> Person : createdBy
    SanitaryAnalysis --> InvestigationTarget : delimits
    SanitaryAnalysis --> AffectedArea : involves
    SanitaryAnalysis --> SpeciesCategory : involves
    InvestigationTarget --> ControlZone : hasZone
    AffectedArea --> ControlZone : delimitedBy
    AnimalMovement --> Establishment : origin
    AnimalMovement --> Establishment : destination
    InvestigationTarget --> AnimalMovement : tracks
    InvestigationTarget --> ContactingProperty : identifies
    AnimalSpecies --> SpeciesCategory : classifiedBy

    %% ═══════════════════════════════════════════
    %% RESPONSE SUBDOMAIN
    %% ═══════════════════════════════════════════
    class SanitaryResponse {
        <<Event>>
    }
    class SurveillanceCycle {
        <<Event>>
    }
    class ZonePerCycle {
        <<Relator>>
    }
    class FieldTeam {
        <<Collective>>
    }
    class TeamType {
        <<Kind>>
    }
    class TeamMember {
        <<Role>>
    }
    class TeamFunction {
        <<Kind>>
    }
    class OperationalArea {
        <<Kind>>
    }
    class PropertyInArea {
        <<Relator>>
    }
    class SanitaryBarrier {
        <<Kind>>
    }
    class Vehicle {
        <<Kind>>
    }
    class CommandPost {
        <<Kind>>
    }
    class SummonedPerson {
        <<Role>>
    }
    class GPSTracking {
        <<Event>>
    }

    SanitaryAnalysis --> SanitaryResponse : basedOn
    SanitaryResponse --> SurveillanceCycle : contains
    SanitaryResponse --> CommandPost : coordinatedFrom
    SanitaryResponse --> SanitaryBarrier : deploys
    SanitaryResponse --> SummonedPerson : mobilises
    SurveillanceCycle --> ZonePerCycle : hasZone
    SurveillanceCycle --> FieldTeam : allocates
    FieldTeam --> TeamMember : composedOf
    FieldTeam --> TeamType : classifiedBy
    FieldTeam --> TeamFunction : performs
    FieldTeam --> OperationalArea : assignedTo
    FieldTeam --> SanitaryBarrier : operates
    FieldTeam --> Vehicle : uses
    FieldTeam --> GPSTracking : trackedBy
    OperationalArea --> ZonePerCycle : belongsTo
    OperationalArea --> PropertyInArea : contains
    PropertyInArea --> Establishment : refersTo
    GPSTracking --> Vehicle : tracks

    %% ═══════════════════════════════════════════
    %% FIELD ACTIONS SUBDOMAIN
    %% ═══════════════════════════════════════════
    class PropertySubmission {
        <<Event>>
    }
    class BarrierSubmission {
        <<Event>>
    }
    class TemporaryProperty {
        <<Role>>
    }
    class VisitConclusion {
        <<Phase>>
    }

    PropertyInArea --> PropertySubmission : generates
    PropertySubmission --> FieldTeam : performedBy
    PropertySubmission --> VisitConclusion : resultsIn
    PropertySubmission --> TemporaryProperty : mayIdentify
    SanitaryBarrier --> BarrierSubmission : generates

    %% ═══════════════════════════════════════════
    %% CROSS-DOMAIN (Role generalises Kind)
    %% ═══════════════════════════════════════════
    InvestigationTarget ..> Establishment : generalizes
    ContactingProperty ..> Establishment : generalizes
    TeamMember ..> Person : generalizes
    SummonedPerson ..> Person : generalizes
    TemporaryProperty ..> Establishment : generalizes

