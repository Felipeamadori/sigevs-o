    %% ═══════════════════════════════════════════
    style SanitaryAnalysis fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    style InvestigationTarget fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    style AffectedArea fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    style ControlZone fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    style AnimalMovement fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    style ContactingProperty fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    style SpeciesCategory fill:#fff3e0,stroke:#ef6c00,stroke-width:2px

    %% ═══════════════════════════════════════════
    %% RESPONSE STYLES (blue)
    %% ═══════════════════════════════════════════
    style SanitaryResponse fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style SurveillanceCycle fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style ZonePerCycle fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style FieldTeam fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style TeamType fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style TeamMember fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style TeamFunction fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style OperationalArea fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style PropertyInArea fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style SanitaryBarrier fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style Vehicle fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style CommandPost fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style SummonedPerson fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style GPSTracking fill:#e3f2fd,stroke:#1565c0,stroke-width:2px

    %% ═══════════════════════════════════════════
    %% FIELD ACTIONS STYLES (pink)
    %% ═══════════════════════════════════════════
    style PropertySubmission fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style BarrierSubmission fill:#fce4ec,stroke:#c62828,stroke-width:2px
    style RegisteredEstablishment fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style UnregisteredEstablishment fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style InspectedEstablishment fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
