title: SIGEVS-O — Modelo Ontológico Completo
---
classDiagram
    %% ═══════════════════════════════════════════
    %% CORE SUBDOMAIN
    %% ═══════════════════════════════════════════
    class Estabelecimento {
        <<Kind>>
    }
    class PropriedadeInspecionada {
        <<Role>>
    }
    class Endereco {
        <<Kind>>
    }
    class EspecieAnimal {
        <<Kind>>
    }
    class Frigorifico {
        <<Subkind>>
    }
    class GranjaSuina {
        <<Subkind>>
    }
    class GranjaAvicola {
        <<Subkind>>
    }
    class Pessoa {
        <<Kind>>
    }

    Estabelecimento "1..*" --> "1" Endereco : possui endereço
    Estabelecimento "*" --> "*" EspecieAnimal : explora espécies
    Estabelecimento <|-- Frigorifico
    Estabelecimento <|-- GranjaSuina
    Estabelecimento <|-- GranjaAvicola

    %% ═══════════════════════════════════════════
    %% INVESTIGATION SUBDOMAIN
    %% ═══════════════════════════════════════════
    class AnaliseSanitaria {
        <<Event>>
    }
    class AlvoInvestigacao {
        <<Role>>
    }
    class AreaAfetada {
        <<Kind>>
    }
    class ZonaControle {
        <<Relator>>
    }
    class MovimentacaoAnimal {
        <<Event>>
    }
    class PropriedadeContactante {
        <<Role>>
    }
    class CategoriaEspecie {
        <<Enumeration>>
    }

    AnaliseSanitaria "*" --> "1" Pessoa : criada por
    AnaliseSanitaria "1" --> "*" AlvoInvestigacao : tem alvo
    AnaliseSanitaria "*" --> "*" AreaAfetada : abrange
    AlvoInvestigacao "1" --> "0..3" ZonaControle : «mediation» tem zona
    MovimentacaoAnimal "*" --> "1" Estabelecimento : origem
    MovimentacaoAnimal "*" --> "1" Estabelecimento : destino
    EspecieAnimal "*" --> "1" CategoriaEspecie : classifica-se por
    Estabelecimento <|-- AlvoInvestigacao
    Estabelecimento <|-- PropriedadeInspecionada
    Estabelecimento <|-- PropriedadeContactante

    %% ═══════════════════════════════════════════
    %% RESPONSE SUBDOMAIN
    %% ═══════════════════════════════════════════
    class RespostaSanitaria {
        <<Event>>
    }
    class CicloVigilancia {
        <<Event>>
    }
    class ZonaPorCiclo {
        <<Relator>>
    }
    class EquipeCampo {
        <<Collective>>
    }
    class TipoEquipe {
        <<Kind>>
    }
    class MembroEquipe {
        <<Role>>
    }
    class FuncaoEmEquipe {
        <<Kind>>
    }
    class AreaOperacional {
        <<Kind>>
    }
    class PropriedadeEmArea {
        <<Relator>>
        Boolean visitaConcluida
    }
    class BarreiraSanitaria {
        <<Kind>>
    }
    class Veiculo {
        <<Kind>>
    }
    class PostoComando {
        <<Kind>>
    }
    class PessoaConvocada {
        <<Role>>
    }
    class RastreamentoGPS {
        <<Event>>
    }

    RespostaSanitaria "*" --> "1" AnaliseSanitaria : baseada em
    RespostaSanitaria "1" --> "*" CicloVigilancia : possui
    RespostaSanitaria "0..1" --> "1" PostoComando : tem posto
    PessoaConvocada "*" --> "1" RespostaSanitaria : convocada para
    CicloVigilancia "1" --> "*" ZonaPorCiclo : «creation» subdivide-se em
    CicloVigilancia "1" --> "*" EquipeCampo : aloca
    EquipeCampo "1" --> "*" MembroEquipe : «memberOf» composta por
    EquipeCampo "*" --> "1" TipoEquipe : classifica-se por
    EquipeCampo "1" --> "*" AreaOperacional : atua em
    EquipeCampo "1" --> "*" BarreiraSanitaria : opera
    EquipeCampo "1" --> "*" Veiculo : utiliza
    MembroEquipe "*" --> "1" FuncaoEmEquipe : desempenha
    PessoaConvocada "*" --> "1" FuncaoEmEquipe : desempenha
    PessoaConvocada "0..1" --> "1" MembroEquipe : alocado como
    AreaOperacional "*" --> "1" ZonaPorCiclo : «mediation» pertence a
    AreaOperacional "1" --> "*" PropriedadeEmArea : «mediation» contém
    PropriedadeEmArea "*" --> "1" PropriedadeInspecionada : «mediation» refere-se a
    RastreamentoGPS "*" --> "1" Veiculo : rastreia
    ZonaControle "1" --> "*" AreaOperacional : «mediation» delimita
    Pessoa <|-- MembroEquipe
    Pessoa <|-- PessoaConvocada

    %% ═══════════════════════════════════════════
    %% FIELD ACTIONS SUBDOMAIN
    %% ═══════════════════════════════════════════
    class SubmissaoPropriedade {
        <<Event>>
    }
    class SubmissaoBarreira {
        <<Event>>
    }
    class EstabelecimentoCadastrado {
        <<Phase>>
    }
    class EstabelecimentoNaoCadastrado {
        <<Phase>>
    }

    SubmissaoPropriedade "*" --> "1" PropriedadeEmArea : vinculada a
    SubmissaoPropriedade "*" --> "1" EquipeCampo : realizada por
    SubmissaoBarreira "*" --> "1" BarreiraSanitaria : vinculada a
    Estabelecimento <|-- EstabelecimentoCadastrado
    Estabelecimento <|-- EstabelecimentoNaoCadastrado
    note for Estabelecimento "Fases de cadastro: {disjoint, complete}"

