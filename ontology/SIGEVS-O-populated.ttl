ex:EstabelecimentoVizinho a sigevs:Estabelecimento ;
    sigevs:codigoEstabelecimento "SDA-002" ;
    sigevs:coordenadas "POINT(-51.4500 -29.6800)" ;
    sigevs:nomeEstabelecimento "Sitio Boa Vista" .

ex:JoaoSilva a sigevs:MembroEquipe,
        sigevs:Pessoa,
        sigevs:PessoaConvocada ;
    sigevs:Convoca ex:RespostaMontenegro ;
    sigevs:cpf "11111111111" ;
    sigevs:emQuarentena false ;
    sigevs:email "joao.silva@example.org" ;
    sigevs:keycloakSubjectId "kc-001" ;
    sigevs:nomePessoa "Joao Silva" ;
    sigevs:permissaoGestao true ;
    sigevs:permissaoObservacao false .

ex:PIA2 a sigevs:PropriedadeEmArea ;
    sigevs:RefereSeA ex:EstabelecimentoVizinho ;
    sigevs:contidaEmArea ex:AreaA ;
    sigevs:visitaConcluida true .

ex:PIA3 a sigevs:PropriedadeEmArea ;
    sigevs:RefereSeA ex:EstabelecimentoIntermediario ;
    sigevs:contidaEmArea ex:AreaB ;
    sigevs:visitaConcluida true .

ex:PostoComando1 a sigevs:PostoComando ;
    sigevs:nomePosto "QG Montenegro" ;
    sigevs:postoDaResposta ex:RespostaMontenegro .

ex:ZonaPerifocal a sigevs:ZonaControleInvestigacao ;
    sigevs:raio 3.0 ;
    sigevs:tipoZona "INFECTED" .

ex:ZonaProtecao a sigevs:ZonaControleInvestigacao ;
    sigevs:raio 15.0 ;
    sigevs:tipoZona "SURVEILLANCE" .

ex:ZonaVigilancia a sigevs:ZonaControleInvestigacao ;
    sigevs:raio 10.0 ;
    sigevs:tipoZona "BUFFER" .

sigevs:Aloca a owl:ObjectProperty ;
    rdfs:label "allocates"@en,
        "Aloca"@pt ;
    rdfs:domain sigevs:CicloVigilancia ;
    rdfs:range sigevs:EquipeCampo .

sigevs:AreaConcluida a owl:Class ;
    rdfs:label "Completed Operational Area"@en,
        "Area Operacional Concluida"@pt ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( sigevs:AreaOperacional [ a owl:Restriction ;
                        owl:allValuesFrom sigevs:PropriedadeVisitada ;
                        owl:onProperty sigevs:Contem ] [ a owl:Restriction ;
                        owl:minCardinality 1 ;
                        owl:onProperty sigevs:Contem ] ) ] .

sigevs:AtuaEm a owl:ObjectProperty ;
    rdfs:label "operates in"@en,
        "Atua em"@pt ;
    rdfs:domain sigevs:EquipeCampo ;
    rdfs:range sigevs:AreaOperacional .

sigevs:BaseadaEm a owl:ObjectProperty ;
    rdfs:label "based on"@en,
        "Baseada em"@pt ;
    rdfs:domain sigevs:RespostaSanitaria ;
    rdfs:range sigevs:AnaliseSanitaria .

sigevs:CategoriaAves a owl:NamedIndividual,
        sigevs:CategoriaEspecie ;
    rdfs:label "AVES"@en .

sigevs:CategoriaBovinos a owl:NamedIndividual,
        sigevs:CategoriaEspecie ;
    rdfs:label "BOVINOS"@en .

sigevs:CategoriaOutros a owl:NamedIndividual,
        sigevs:CategoriaEspecie ;
    rdfs:label "OUTROS"@en .

sigevs:CategoriaOvinos a owl:NamedIndividual,
        sigevs:CategoriaEspecie ;
    rdfs:label "OVINOS"@en .

sigevs:CategoriaSuinos a owl:NamedIndividual,
        sigevs:CategoriaEspecie ;
    rdfs:label "SUINOS"@en .

sigevs:CompostaPor a owl:ObjectProperty ;
    rdfs:label "composed of"@en,
        "Composta por"@pt ;
    rdfs:domain sigevs:EquipeCampo ;
    rdfs:range sigevs:MembroEquipe .

sigevs:Convoca a owl:ObjectProperty ;
    rdfs:label "summons for"@en,
        "Convoca"@pt ;
    rdfs:domain sigevs:PessoaConvocada ;
    rdfs:range sigevs:RespostaSanitaria .

sigevs:Possui a owl:ObjectProperty ;
    rdfs:label "has cycle"@en,
        "Possui"@pt ;
    rdfs:domain sigevs:RespostaSanitaria ;
    rdfs:range sigevs:CicloVigilancia .

sigevs:PropriedadeVisitada a owl:Class ;
    rdfs:label "Visited Property in Area"@en,
        "Propriedade em Area Visitada"@pt ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( sigevs:PropriedadeEmArea [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty sigevs:visitaConcluida ] ) ] .

sigevs:RealizadaPor a owl:ObjectProperty ;
    rdfs:label "performed by"@en,
        "Realizada por"@pt ;
    rdfs:domain sigevs:SubmissaoPropriedade ;
    rdfs:range sigevs:EquipeCampo .

sigevs:SubdivideSe a owl:ObjectProperty ;
    rdfs:label "subdivides into"@en,
        "Subdivide-se"@pt ;
    rdfs:domain sigevs:CicloVigilancia ;
    rdfs:range sigevs:ZonaPorCiclo .

sigevs:VinculadaA a owl:ObjectProperty ;
    rdfs:label "linked to"@en,
        "Vinculada a"@pt ;
    rdfs:domain sigevs:SubmissaoPropriedade ;
    rdfs:range sigevs:PropriedadeEmArea .

sigevs:alvoDeAnalise a owl:ObjectProperty ;
    rdfs:label "target of analysis"@en ;
    rdfs:domain sigevs:AlvoInvestigacao ;
    rdfs:range sigevs:AnaliseSanitaria ;
    owl:inverseOf sigevs:analiseSanitariaHasAlvoInvestigacao .

sigevs:alvoInvestigacaoHasZonaControleInvestigacao a owl:ObjectProperty ;
    rdfs:label "has control zone"@en ;
    rdfs:domain sigevs:AlvoInvestigacao ;
    rdfs:range sigevs:ZonaControleInvestigacao .

sigevs:analiseAtiva a owl:DatatypeProperty ;
    rdfs:label "active analysis"@en ;
    rdfs:domain sigevs:AnaliseSanitaria ;
    rdfs:range xsd:boolean .

sigevs:areaDaEquipe a owl:ObjectProperty ;
    rdfs:label "belongs to team"@en ;
    rdfs:domain sigevs:AreaOperacional ;
    rdfs:range sigevs:EquipeCampo ;
    owl:inverseOf sigevs:AtuaEm .

sigevs:areaDoCiclo a owl:ObjectProperty ;
    rdfs:label "cycle of area"@en ;
    rdfs:domain sigevs:AreaOperacional ;
    rdfs:range sigevs:CicloVigilancia ;
    owl:propertyChainAxiom ( sigevs:PertenceA sigevs:zonaDoCiclo ) .

sigevs:cicloFechado a owl:DatatypeProperty ;
    rdfs:label "closed cycle"@en ;
    rdfs:domain sigevs:CicloVigilancia ;
    rdfs:range xsd:boolean .

sigevs:contidaEmArea a owl:ObjectProperty ;
    rdfs:label "contained in area"@en ;
    rdfs:domain sigevs:PropriedadeEmArea ;
    rdfs:range sigevs:AreaOperacional ;
    owl:inverseOf sigevs:Contem .

sigevs:equipeAlocadaEm a owl:ObjectProperty ;
    rdfs:label "allocated to cycle"@en ;
    rdfs:domain sigevs:EquipeCampo ;
    rdfs:range sigevs:CicloVigilancia ;
    owl:inverseOf sigevs:Aloca .

sigevs:fimRastreamento a owl:DatatypeProperty ;
    rdfs:label "tracking end"@en ;
    rdfs:domain sigevs:RastreamentoGps ;
    rdfs:range xsd:dateTime .

sigevs:inicioRastreamento a owl:DatatypeProperty ;
    rdfs:label "tracking start"@en ;
    rdfs:domain sigevs:RastreamentoGps ;
    rdfs:range xsd:dateTime .

sigevs:permissaoGestao a owl:DatatypeProperty ;
    rdfs:label "management permission"@en ;
    rdfs:domain sigevs:PessoaConvocada ;
    rdfs:range xsd:boolean .

sigevs:permissaoObservacao a owl:DatatypeProperty ;
    rdfs:label "observer permission"@en ;
    rdfs:domain sigevs:PessoaConvocada ;
    rdfs:range xsd:boolean .

sigevs:postoDaResposta a owl:ObjectProperty ;
    rdfs:label "command post of response"@en ;
    rdfs:domain sigevs:PostoComando ;
    rdfs:range sigevs:RespostaSanitaria ;
    owl:inverseOf sigevs:Tem .

sigevs:quarentenaAte a owl:DatatypeProperty ;
    rdfs:label "quarantine until"@en ;
    rdfs:domain sigevs:PessoaConvocada ;
    rdfs:range xsd:dateTime .

sigevs:respostaAtiva a owl:DatatypeProperty ;
    rdfs:label "active response"@en ;
    rdfs:domain sigevs:RespostaSanitaria ;
    rdfs:range xsd:boolean .

sigevs:respostaConcluida a owl:DatatypeProperty ;
    rdfs:label "completed response"@en ;
    rdfs:domain sigevs:RespostaSanitaria ;
    rdfs:range xsd:boolean .

sigevs:submissaoBarreiraHasBarreiraSanitaria a owl:ObjectProperty ;
    rdfs:label "linked to barrier"@en ;
    rdfs:domain sigevs:SubmissaoBarreira ;
    rdfs:range sigevs:BarreiraSanitaria .

sigevs:zonaDoCiclo a owl:ObjectProperty ;
    rdfs:label "zone of cycle"@en ;
    rdfs:domain sigevs:ZonaPorCiclo ;
    rdfs:range sigevs:CicloVigilancia ;
    owl:inverseOf sigevs:SubdivideSe .

sigevs:zonaFechada a owl:DatatypeProperty ;
    rdfs:label "closed zone"@en ;
    rdfs:domain sigevs:ZonaPorCiclo ;
    rdfs:range xsd:boolean .

ex:AnaliseHPAI a sigevs:AnaliseSanitaria ;
    sigevs:analiseAtiva true ;
    sigevs:criadaEm "2025-05-16T08:00:00"^^xsd:dateTime ;
    sigevs:nomeAnalise "Investigacao HPAI Montenegro" .

ex:AreaA a sigevs:AreaOperacional ;
    sigevs:Contem ex:PIA1,
        ex:PIA2 ;
    sigevs:PertenceA ex:ZonaCiclo1 ;
    sigevs:areaDaEquipe ex:EquipeA ;
    sigevs:nomeArea "Area A" .

ex:EquipeA a sigevs:EquipeCampo ;
    sigevs:CompostaPor ex:AnaPereira,
        ex:JoaoSilva ;
    sigevs:equipeAlocadaEm ex:Ciclo1 ;
    sigevs:nomeEquipe "Equipe A" .

ex:PIA1 a sigevs:PropriedadeEmArea ;
    sigevs:RefereSeA ex:EstabelecimentoFoco ;
    sigevs:contidaEmArea ex:AreaA ;
    sigevs:visitaConcluida true .

ex:ZonaCiclo1 a sigevs:ZonaPorCiclo ;
    sigevs:zonaDoCiclo ex:Ciclo1 ;
    sigevs:zonaFechada true .

sigevs:EspecieAnimal a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Animal Species"@en,
        "Especie Animal"@pt ;
    rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .

sigevs:Funcao a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Function"@en,
        "Funcao"@pt ;
    rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .

sigevs:PertenceA a owl:ObjectProperty ;
    rdfs:label "belongs to"@en,
        "Pertence a"@pt ;
    rdfs:domain sigevs:AreaOperacional ;
    rdfs:range sigevs:ZonaPorCiclo .

sigevs:Tem a owl:ObjectProperty ;
    rdfs:label "has command post"@en,
        "Tem"@pt ;
    rdfs:domain sigevs:RespostaSanitaria ;
    rdfs:range sigevs:PostoComando .

sigevs:analiseSanitariaHasAlvoInvestigacao a owl:ObjectProperty ;
    rdfs:label "has investigation target"@en ;
    rdfs:domain sigevs:AnaliseSanitaria ;
    rdfs:range sigevs:AlvoInvestigacao .

sigevs:cicloPertenceAResposta a owl:ObjectProperty ;
    rdfs:label "belongs to response"@en ;
    rdfs:domain sigevs:CicloVigilancia ;
    rdfs:range sigevs:RespostaSanitaria ;
    owl:inverseOf sigevs:Possui .

sigevs:codigoEstabelecimento a owl:DatatypeProperty ;
    rdfs:label "SDA code"@en,
        "Codigo SDA"@pt ;
    rdfs:domain sigevs:Estabelecimento ;
    rdfs:range xsd:string .

sigevs:coordenadas a owl:DatatypeProperty ;
    rdfs:label "coordinates (WKT)"@en,
        "Coordenadas (WKT)"@pt ;
    rdfs:comment "AX-GEO-02: coordinates stored as WKT strings (PostGIS GEOGRAPHY at implementation level; consumed as WKT literals by GeoSPARQL queries)."@en ;
    rdfs:range xsd:string .

sigevs:cpf a owl:DatatypeProperty ;
    rdfs:label "CPF"@en ;
    rdfs:domain sigevs:Pessoa ;
    rdfs:range xsd:string .

sigevs:emQuarentena a owl:DatatypeProperty ;
    rdfs:label "in quarantine"@en ;
    rdfs:domain sigevs:PessoaConvocada ;
    rdfs:range xsd:boolean .

sigevs:email a owl:DatatypeProperty ;
    rdfs:label "email"@en ;
    rdfs:domain sigevs:Pessoa ;
    rdfs:range xsd:string .

sigevs:numeroCiclo a owl:DatatypeProperty ;
    rdfs:label "cycle number"@en ;
    rdfs:domain sigevs:CicloVigilancia ;
    rdfs:range xsd:integer .

sigevs:numeroGTA a owl:DatatypeProperty ;
    rdfs:label "GTA number"@en ;
    rdfs:domain sigevs:MovimentacaoAnimal ;
    rdfs:range xsd:string .

sigevs:serie a owl:DatatypeProperty ;
    rdfs:label "GTA series"@en ;
    rdfs:domain sigevs:MovimentacaoAnimal ;
    rdfs:range xsd:string .

sigevs:ufOrigem a owl:DatatypeProperty ;
    rdfs:label "origin state"@en ;
    rdfs:domain sigevs:MovimentacaoAnimal ;
    rdfs:range xsd:string .

sigevs:visitaConcluida a owl:DatatypeProperty ;
    rdfs:label "visit completed"@en ;
    rdfs:domain sigevs:PropriedadeEmArea ;
    rdfs:range xsd:boolean .

ex:Ciclo1 a sigevs:CicloVigilancia ;
    sigevs:cicloFechado true ;
    sigevs:cicloPertenceAResposta ex:RespostaMontenegro ;
    sigevs:numeroCiclo 1 .

ex:RespostaMontenegro a sigevs:RespostaSanitaria ;
    sigevs:BaseadaEm ex:AnaliseHPAI ;
    sigevs:Tem ex:PostoComando1 ;
    sigevs:identificadorResposta "RESP-2025-001" ;
    sigevs:respostaAtiva true ;
    sigevs:respostaConcluida false .

sigevs:AreaAfetada a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Affected Area"@en,
        "Area Afetada"@pt ;
    rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .

sigevs:Contem a owl:ObjectProperty ;
    rdfs:label "contains"@en,
        "Contem"@pt ;
    rdfs:domain sigevs:AreaOperacional ;
    rdfs:range sigevs:PropriedadeEmArea .

sigevs:Frigorifico a <http://purl.org/nemo/gufo#SubKind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Slaughterhouse"@en,
        "Frigorifico"@pt ;
    rdfs:subClassOf sigevs:Estabelecimento .

sigevs:keycloakSubjectId a owl:DatatypeProperty ;
    rdfs:label "Keycloak subject id"@en ;
    rdfs:domain sigevs:Pessoa ;
    rdfs:range xsd:string .

sigevs:GranjaAve a <http://purl.org/nemo/gufo#SubKind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Poultry Farm"@en,
        "Granja de Aves"@pt ;
    rdfs:subClassOf sigevs:Estabelecimento .

sigevs:GranjaSuino a <http://purl.org/nemo/gufo#SubKind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Swine Farm"@en,
        "Granja de Suinos"@pt ;
    rdfs:subClassOf sigevs:Estabelecimento .

sigevs:PropriedadeTemporaria a <http://purl.org/nemo/gufo#Role>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Temporary Property"@en,
        "Propriedade Temporaria"@pt ;
    rdfs:subClassOf sigevs:Estabelecimento .

sigevs:SubmissaoBarreira a <http://purl.org/nemo/gufo#EventType>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Barrier Submission"@en,
        "Submissao de Barreira"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:submissaoBarreiraHasBarreiraSanitaria ],
        <http://purl.org/nemo/gufo#Event> .

sigevs:TipoEquipe a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Team Type"@en,
        "Tipo de Equipe"@pt ;
    rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .

sigevs:RastreamentoGps a <http://purl.org/nemo/gufo#EventType>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "GPS Tracking"@en,
        "Rastreamento GPS"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:inicioRastreamento ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sigevs:fimRastreamento ],
        <http://purl.org/nemo/gufo#Event> .

sigevs:SubmissaoPropriedade a <http://purl.org/nemo/gufo#EventType>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Property Submission"@en,
        "Submissao de Propriedade"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:VinculadaA ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:RealizadaPor ],
        <http://purl.org/nemo/gufo#Event> .

sigevs:BarreiraSanitaria a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sanitary Barrier"@en,
        "Barreira Sanitaria"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:coordenadas ],
        <http://purl.org/nemo/gufo#FunctionalComplex> .

sigevs:CategoriaEspecie a <http://purl.org/nemo/gufo#AbstractIndividualType>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Species Category"@en,
        "Categoria de Especie"@pt ;
    rdfs:subClassOf <http://purl.org/nemo/gufo#QualityValue> ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( sigevs:CategoriaAves sigevs:CategoriaSuinos sigevs:CategoriaOvinos sigevs:CategoriaBovinos sigevs:CategoriaOutros ) ] .

sigevs:MembroEquipe a <http://purl.org/nemo/gufo#Role>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Team Member"@en,
        "Membro de Equipe"@pt ;
    rdfs:subClassOf sigevs:Pessoa .

sigevs:PostoComando a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Command Post"@en,
        "Posto de Comando"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sigevs:postoDaResposta ],
        <http://purl.org/nemo/gufo#FunctionalComplex> .

sigevs:Endereco a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Address"@en,
        "Endereco"@pt ;
    rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .

sigevs:ZonaControleInvestigacao a owl:Class ;
    rdfs:label "Investigation Control Zone"@en,
        "Zona de Controle da Investigacao"@pt ;
    rdfs:subClassOf <http://purl.org/nemo/gufo#Relator> .

sigevs:PessoaConvocada a <http://purl.org/nemo/gufo#Role>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Summoned Person"@en,
        "Pessoa Convocada"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:emQuarentena ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:permissaoGestao ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:permissaoObservacao ],
        sigevs:Pessoa ;
    owl:hasKey ( sigevs:keycloakSubjectId sigevs:Convoca ) .

sigevs:Veiculo a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Vehicle"@en,
        "Veiculo"@pt ;
    rdfs:subClassOf <http://purl.org/nemo/gufo#FunctionalComplex> .

sigevs:ZonaPorCiclo a owl:Class ;
    rdfs:label "Zone per Cycle"@en,
        "Zona por Ciclo"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:zonaFechada ],
        <http://purl.org/nemo/gufo#Relator> .

sigevs:AlvoInvestigacao a <http://purl.org/nemo/gufo#Role>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Investigation Target"@en,
        "Alvo de Investigacao"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:alvoDeAnalise ],
        [ a owl:Restriction ;
            owl:maxCardinality 3 ;
            owl:onProperty sigevs:alvoInvestigacaoHasZonaControleInvestigacao ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:coordenadas ],
        sigevs:Estabelecimento .

sigevs:MovimentacaoAnimal a <http://purl.org/nemo/gufo#EventType>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Animal Movement"@en,
        "Movimentacao Animal"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:serie ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:numeroGTA ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:ufOrigem ],
        <http://purl.org/nemo/gufo#Event> ;
    owl:hasKey ( sigevs:serie sigevs:numeroGTA sigevs:ufOrigem ) .

sigevs:PropriedadeEmArea a owl:Class ;
    rdfs:label "Property in Area"@en,
        "Propriedade em Area"@pt ;
    rdfs:comment "AX-SEQ-04: the visit status may transition from completed back to pending (reopen operation); modelled as a state transition, not as an OWL restriction."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:contidaEmArea ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:visitaConcluida ],
        <http://purl.org/nemo/gufo#Relator> .

sigevs:CicloVigilancia a <http://purl.org/nemo/gufo#EventType>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Surveillance Cycle"@en,
        "Ciclo de Vigilancia"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:cicloPertenceAResposta ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:numeroCiclo ],
        <http://purl.org/nemo/gufo#Event> ;
    owl:hasKey ( sigevs:numeroCiclo sigevs:cicloPertenceAResposta ) .

sigevs:AnaliseSanitaria a <http://purl.org/nemo/gufo#EventType>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sanitary Analysis"@en,
        "Analise Sanitaria"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sigevs:analiseSanitariaHasAlvoInvestigacao ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:analiseAtiva ],
        <http://purl.org/nemo/gufo#Event> .

sigevs:AreaOperacional a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Operational Area"@en,
        "Area Operacional"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:areaDaEquipe ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:PertenceA ],
        <http://purl.org/nemo/gufo#FunctionalComplex> .

sigevs:Pessoa a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Person"@en,
        "Pessoa"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:keycloakSubjectId ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:cpf ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:email ],
        <http://purl.org/nemo/gufo#FunctionalComplex> ;
    owl:hasKey ( sigevs:keycloakSubjectId ),
        ( sigevs:cpf ),
        ( sigevs:email ) .

sigevs:EquipeCampo a owl:Class ;
    rdfs:label "Field Team"@en,
        "Equipe de Campo"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:equipeAlocadaEm ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty sigevs:CompostaPor ],
        <http://purl.org/nemo/gufo#VariableCollection> .

sigevs:RespostaSanitaria a <http://purl.org/nemo/gufo#EventType>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sanitary Response"@en,
        "Resposta Sanitaria"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:BaseadaEm ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty sigevs:Tem ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:respostaAtiva ],
        [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:respostaConcluida ],
        <http://purl.org/nemo/gufo#Event> .

sigevs:Estabelecimento a <http://purl.org/nemo/gufo#Kind>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Establishment"@en,
        "Estabelecimento"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:codigoEstabelecimento ],
        <http://purl.org/nemo/gufo#FunctionalComplex> ;
    owl:hasKey ( sigevs:codigoEstabelecimento ) .

