@prefix ex: <http://example.org/sigevs-sample#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sigevs: <https://sigevs.ontologies#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:EstabelecimentoDistante a sigevs:Estabelecimento ;
    sigevs:codigoEstabelecimento "SDA-004" ;
    sigevs:coordenadas "POINT(-51.2000 -29.5000)" ;
    sigevs:nomeEstabelecimento "Fazenda Santa Rita" .

ex:FocoHPAI a sigevs:AlvoInvestigacao ;
    sigevs:alvoDeAnalise ex:AnaliseHPAI ;
    sigevs:alvoInvestigacaoHasZonaControleInvestigacao ex:ZonaPerifocal,
        ex:ZonaProtecao,
        ex:ZonaVigilancia ;
    sigevs:coordenadas "POINT(-51.4611 -29.6886)" ;
    sigevs:nomeAlvo "Foco HPAI" .

ex:Submissao1 a sigevs:SubmissaoPropriedade ;
    sigevs:RealizadaPor ex:EquipeA ;
    sigevs:VinculadaA ex:PIA1 ;
    sigevs:uuidSubmissao "sub-0001" .

ex:SubmissaoBarreira1 a sigevs:SubmissaoBarreira ;
    sigevs:submissaoBarreiraHasBarreiraSanitaria ex:BarreiraBR287 ;
    sigevs:uuidSubmissaoBarreira "sub-bar-0001" .

ex:Temporaria1 a sigevs:PropriedadeTemporaria ;
    sigevs:coordenadas "POINT(-51.4600 -29.6870)" ;
    sigevs:cpfCnpj "44444444444" ;
    sigevs:nomeContato "Maria Souza" ;
    sigevs:telefone "+55 55 99999-0000" .

<https://sigevs.ontologies> a owl:Ontology ;
    rdfs:comment "SIGEVS-O: A Domain Ontology for Veterinary Emergency Management. gUFO/OWL formalisation completed from the Visual Paradigm export (SIGEVS-O.ttl), including attributes, inverse relations, keys and the formal axioms documented in the SABiOx artefacts."@en ;
    owl:imports <http://purl.org/nemo/gufo#> ;
    owl:versionInfo "1.0" .

sigevs:CicloFechado a owl:Class ;
    rdfs:label "Closed Surveillance Cycle"@en,
        "Ciclo de Vigilancia Fechado"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom sigevs:AreaConcluida ;
            owl:onProperty sigevs:areaDoCiclo ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( sigevs:CicloVigilancia [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty sigevs:cicloFechado ] ) ] .

sigevs:ClassificaSe a owl:ObjectProperty ;
    rdfs:label "classified as"@en,
        "Classifica-se"@pt ;
    rdfs:domain sigevs:EquipeCampo ;
    rdfs:range sigevs:TipoEquipe .

sigevs:CriadaPor a owl:ObjectProperty ;
    rdfs:label "created by"@en,
        "Criada por"@pt ;
    rdfs:domain sigevs:AnaliseSanitaria ;
    rdfs:range sigevs:Pessoa .

sigevs:Desempenha a owl:ObjectProperty ;
    rdfs:label "performs"@en,
        "Desempenha"@pt ;
    rdfs:domain sigevs:MembroEquipe ;
    rdfs:range sigevs:Funcao .

sigevs:Destino a owl:ObjectProperty ;
    rdfs:label "destination"@en,
        "Destino"@pt ;
    rdfs:domain sigevs:MovimentacaoAnimal ;
    rdfs:range sigevs:Estabelecimento .

sigevs:Opera a owl:ObjectProperty ;
    rdfs:label "operates"@en,
        "Opera"@pt ;
    rdfs:domain sigevs:EquipeCampo ;
    rdfs:range sigevs:BarreiraSanitaria .

sigevs:Origem a owl:ObjectProperty ;
    rdfs:label "origin"@en,
        "Origem"@pt ;
    rdfs:domain sigevs:MovimentacaoAnimal ;
    rdfs:range sigevs:Estabelecimento .

sigevs:PessoaEmQuarentena a owl:Class ;
    rdfs:label "Person in Quarantine"@en,
        "Pessoa em Quarentena"@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty sigevs:quarentenaAte ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( sigevs:PessoaConvocada [ a owl:Restriction ;
                        owl:hasValue true ;
                        owl:onProperty sigevs:emQuarentena ] ) ] .

sigevs:PropriedadeContactante a <http://purl.org/nemo/gufo#Role>,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Contacting Property"@en,
        "Propriedade Contactante"@pt ;
    rdfs:subClassOf sigevs:Estabelecimento .

sigevs:RefereSeA a owl:ObjectProperty ;
    rdfs:label "refers to"@en,
        "Refere-se a"@pt ;
    rdfs:domain sigevs:PropriedadeEmArea ;
    rdfs:range sigevs:Estabelecimento .

sigevs:Utiliza a owl:ObjectProperty ;
    rdfs:label "uses"@en,
        "Utiliza"@pt ;
    rdfs:domain sigevs:EquipeCampo ;
    rdfs:range sigevs:Veiculo .

sigevs:analisePublica a owl:DatatypeProperty ;
    rdfs:label "public analysis"@en ;
    rdfs:domain sigevs:AnaliseSanitaria ;
    rdfs:range xsd:boolean .

sigevs:analiseSanitariaHasAreaAfetada a owl:ObjectProperty ;
    rdfs:label "has affected area"@en ;
    rdfs:domain sigevs:AnaliseSanitaria ;
    rdfs:range sigevs:AreaAfetada .

