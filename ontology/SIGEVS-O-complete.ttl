#################################################################
# Datatype properties — Sanitary Investigation
#################################################################

:nomeAnalise a owl:DatatypeProperty ;
    rdfs:domain :AnaliseSanitaria ;
    rdfs:range xsd:string ;
    rdfs:label "analysis name"@en .

:analiseAtiva a owl:DatatypeProperty ;
    rdfs:domain :AnaliseSanitaria ;
