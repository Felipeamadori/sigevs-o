:geometriaZona a owl:DatatypeProperty ;
    rdfs:domain :ZonaControleInvestigacao ;
    rdfs:range xsd:string ;
    rdfs:label "zone geometry (WKT)"@en .

:serie a owl:DatatypeProperty ;
    rdfs:domain :MovimentacaoAnimal ;
    rdfs:range xsd:string ;
    rdfs:label "GTA series"@en .

:numeroGTA a owl:DatatypeProperty ;
    rdfs:domain :MovimentacaoAnimal ;
    rdfs:range xsd:string ;
    rdfs:label "GTA number"@en .

:ufOrigem a owl:DatatypeProperty ;
    rdfs:domain :MovimentacaoAnimal ;
