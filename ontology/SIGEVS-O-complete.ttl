@prefix : <https://sigevs.ontologies#>.
@prefix gufo: <http://purl.org/nemo/gufo#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

#################################################################
# Ontology header
#################################################################

<https://sigevs.ontologies> a owl:Ontology ;
    rdfs:comment "SIGEVS-O: A Domain Ontology for Veterinary Emergency Management. gUFO/OWL formalisation completed from the Visual Paradigm export (SIGEVS-O.ttl), including attributes, inverse relations, keys and the formal axioms documented in the SABiOx artefacts."@en ;
    owl:imports gufo: ;
    owl:versionInfo "1.0" .

#################################################################
# Classes — Core subdomain
#################################################################

:Estabelecimento a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Establishment"@en, "Estabelecimento"@pt .

:Endereco a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Address"@en, "Endereco"@pt .

:Pessoa a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Person"@en, "Pessoa"@pt .

:EspecieAnimal a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Animal Species"@en, "Especie Animal"@pt .

:Frigorifico a owl:Class, gufo:SubKind, owl:NamedIndividual ;
    rdfs:label "Slaughterhouse"@en, "Frigorifico"@pt .

:GranjaAve a owl:Class, gufo:SubKind, owl:NamedIndividual ;
    rdfs:label "Poultry Farm"@en, "Granja de Aves"@pt .

:GranjaSuino a owl:Class, gufo:SubKind, owl:NamedIndividual ;
    rdfs:label "Swine Farm"@en, "Granja de Suinos"@pt .

#################################################################
# Classes — Sanitary Investigation subdomain
#################################################################

:AnaliseSanitaria a owl:Class, gufo:EventType, owl:NamedIndividual ;
    rdfs:subClassOf gufo:Event ;
    rdfs:label "Sanitary Analysis"@en, "Analise Sanitaria"@pt .

:AlvoInvestigacao a owl:Class, gufo:Role, owl:NamedIndividual ;
    rdfs:label "Investigation Target"@en, "Alvo de Investigacao"@pt .

:AreaAfetada a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Affected Area"@en, "Area Afetada"@pt .

:ZonaControleInvestigacao a owl:Class ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Investigation Control Zone"@en, "Zona de Controle da Investigacao"@pt .

:MovimentacaoAnimal a owl:Class, gufo:EventType, owl:NamedIndividual ;
    rdfs:subClassOf gufo:Event ;
    rdfs:label "Animal Movement"@en, "Movimentacao Animal"@pt .

:PropriedadeContactante a owl:Class, gufo:Role, owl:NamedIndividual ;
    rdfs:label "Contacting Property"@en, "Propriedade Contactante"@pt .

:CategoriaEspecie a owl:Class, gufo:AbstractIndividualType, owl:NamedIndividual ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [
        a owl:Class ;
        owl:oneOf ( :CategoriaAves :CategoriaSuinos :CategoriaOvinos :CategoriaBovinos :CategoriaOutros )
    ] ;
    rdfs:label "Species Category"@en, "Categoria de Especie"@pt .

#################################################################
# Classes — Sanitary Response subdomain
#################################################################

:RespostaSanitaria a owl:Class, gufo:EventType, owl:NamedIndividual ;
    rdfs:subClassOf gufo:Event ;
    rdfs:label "Sanitary Response"@en, "Resposta Sanitaria"@pt .

:CicloVigilancia a owl:Class, gufo:EventType, owl:NamedIndividual ;
    rdfs:subClassOf gufo:Event ;
    rdfs:label "Surveillance Cycle"@en, "Ciclo de Vigilancia"@pt .

:ZonaPorCiclo a owl:Class ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Zone per Cycle"@en, "Zona por Ciclo"@pt .

:EquipeCampo a owl:Class ;
    rdfs:subClassOf gufo:VariableCollection ;
    rdfs:label "Field Team"@en, "Equipe de Campo"@pt .

:MembroEquipe a owl:Class, gufo:Role, owl:NamedIndividual ;
    rdfs:label "Team Member"@en, "Membro de Equipe"@pt .

:Funcao a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Function"@en, "Funcao"@pt .

:AreaOperacional a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Operational Area"@en, "Area Operacional"@pt .

:PropriedadeEmArea a owl:Class ;
    rdfs:subClassOf gufo:Relator ;
    rdfs:label "Property in Area"@en, "Propriedade em Area"@pt .

:BarreiraSanitaria a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Sanitary Barrier"@en, "Barreira Sanitaria"@pt .

:Veiculo a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Vehicle"@en, "Veiculo"@pt .

:PostoComando a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Command Post"@en, "Posto de Comando"@pt .

:PessoaConvocada a owl:Class, gufo:Role, owl:NamedIndividual ;
    rdfs:label "Summoned Person"@en, "Pessoa Convocada"@pt .

:RastreamentoGps a owl:Class, gufo:EventType, owl:NamedIndividual ;
    rdfs:subClassOf gufo:Event ;
    rdfs:label "GPS Tracking"@en, "Rastreamento GPS"@pt .

:TipoEquipe a owl:Class, gufo:Kind, owl:NamedIndividual ;
    rdfs:subClassOf gufo:FunctionalComplex ;
    rdfs:label "Team Type"@en, "Tipo de Equipe"@pt .

#################################################################
# Classes — Field Actions subdomain
#################################################################

:SubmissaoPropriedade a owl:Class, gufo:EventType, owl:NamedIndividual ;
    rdfs:subClassOf gufo:Event ;
    rdfs:label "Property Submission"@en, "Submissao de Propriedade"@pt .

:SubmissaoBarreira a owl:Class, gufo:EventType, owl:NamedIndividual ;
    rdfs:subClassOf gufo:Event ;
    rdfs:label "Barrier Submission"@en, "Submissao de Barreira"@pt .

:PropriedadeTemporaria a owl:Class, gufo:Role, owl:NamedIndividual ;
    rdfs:label "Temporary Property"@en, "Propriedade Temporaria"@pt .

#################################################################
# Enumeration values (CategoriaEspecie)
#################################################################

:CategoriaAves a owl:NamedIndividual, :CategoriaEspecie ;
    rdfs:label "AVES"@en .

:CategoriaSuinos a owl:NamedIndividual, :CategoriaEspecie ;
    rdfs:label "SUINOS"@en .

:CategoriaOvinos a owl:NamedIndividual, :CategoriaEspecie ;
    rdfs:label "OVINOS"@en .

:CategoriaBovinos a owl:NamedIndividual, :CategoriaEspecie ;
    rdfs:label "BOVINOS"@en .

:CategoriaOutros a owl:NamedIndividual, :CategoriaEspecie ;
    rdfs:label "OUTROS"@en .

#################################################################
# Generalizations
#################################################################

:Frigorifico rdfs:subClassOf :Estabelecimento .
:GranjaAve rdfs:subClassOf :Estabelecimento .
:GranjaSuino rdfs:subClassOf :Estabelecimento .
:AlvoInvestigacao rdfs:subClassOf :Estabelecimento .
:PropriedadeContactante rdfs:subClassOf :Estabelecimento .
:PessoaConvocada rdfs:subClassOf :Pessoa .
:MembroEquipe rdfs:subClassOf :Pessoa .
:PropriedadeTemporaria rdfs:subClassOf :Estabelecimento .

#################################################################
# Object properties
#################################################################

:estabelecimentoHasEndereco a owl:ObjectProperty ;
    rdfs:domain :Estabelecimento ;
    rdfs:range :Endereco ;
    rdfs:label "has address"@en .

:analiseSanitariaHasAlvoInvestigacao a owl:ObjectProperty ;
    rdfs:domain :AnaliseSanitaria ;
    rdfs:range :AlvoInvestigacao ;
    rdfs:label "has investigation target"@en .

:analiseSanitariaHasAreaAfetada a owl:ObjectProperty ;
    rdfs:domain :AnaliseSanitaria ;
    rdfs:range :AreaAfetada ;
    rdfs:label "has affected area"@en .

:CriadaPor a owl:ObjectProperty ;
    rdfs:domain :AnaliseSanitaria ;
    rdfs:range :Pessoa ;
    rdfs:label "created by"@en, "Criada por"@pt .

:alvoInvestigacaoHasZonaControleInvestigacao a owl:ObjectProperty ;
    rdfs:domain :AlvoInvestigacao ;
    rdfs:range :ZonaControleInvestigacao ;
    rdfs:label "has control zone"@en .

:Origem a owl:ObjectProperty ;
    rdfs:domain :MovimentacaoAnimal ;
    rdfs:range :Estabelecimento ;
    rdfs:label "origin"@en, "Origem"@pt .

:Destino a owl:ObjectProperty ;
    rdfs:domain :MovimentacaoAnimal ;
    rdfs:range :Estabelecimento ;
    rdfs:label "destination"@en, "Destino"@pt .

:BaseadaEm a owl:ObjectProperty ;
    rdfs:domain :RespostaSanitaria ;
    rdfs:range :AnaliseSanitaria ;
    rdfs:label "based on"@en, "Baseada em"@pt .

:Possui a owl:ObjectProperty ;
    rdfs:domain :RespostaSanitaria ;
    rdfs:range :CicloVigilancia ;
    rdfs:label "has cycle"@en, "Possui"@pt .

:Tem a owl:ObjectProperty ;
    rdfs:domain :RespostaSanitaria ;
    rdfs:range :PostoComando ;
    rdfs:label "has command post"@en, "Tem"@pt .

:Convoca a owl:ObjectProperty ;
    rdfs:domain :PessoaConvocada ;
    rdfs:range :RespostaSanitaria ;
    rdfs:label "summons for"@en, "Convoca"@pt .

:SubdivideSe a owl:ObjectProperty ;
    rdfs:domain :CicloVigilancia ;
    rdfs:range :ZonaPorCiclo ;
    rdfs:label "subdivides into"@en, "Subdivide-se"@pt .

:Aloca a owl:ObjectProperty ;
    rdfs:domain :CicloVigilancia ;
    rdfs:range :EquipeCampo ;
    rdfs:label "allocates"@en, "Aloca"@pt .

:ClassificaSe a owl:ObjectProperty ;
    rdfs:domain :EquipeCampo ;
    rdfs:range :TipoEquipe ;
    rdfs:label "classified as"@en, "Classifica-se"@pt .

:CompostaPor a owl:ObjectProperty ;
    rdfs:domain :EquipeCampo ;
    rdfs:range :MembroEquipe ;
    rdfs:label "composed of"@en, "Composta por"@pt .

:AtuaEm a owl:ObjectProperty ;
    rdfs:domain :EquipeCampo ;
    rdfs:range :AreaOperacional ;
    rdfs:label "operates in"@en, "Atua em"@pt .

:Utiliza a owl:ObjectProperty ;
    rdfs:domain :EquipeCampo ;
    rdfs:range :Veiculo ;
    rdfs:label "uses"@en, "Utiliza"@pt .

:Opera a owl:ObjectProperty ;
    rdfs:domain :EquipeCampo ;
    rdfs:range :BarreiraSanitaria ;
    rdfs:label "operates"@en, "Opera"@pt .

:Desempenha a owl:ObjectProperty ;
    rdfs:domain :MembroEquipe ;
    rdfs:range :Funcao ;
    rdfs:label "performs"@en, "Desempenha"@pt .

:PertenceA a owl:ObjectProperty ;
    rdfs:domain :AreaOperacional ;
    rdfs:range :ZonaPorCiclo ;
    rdfs:label "belongs to"@en, "Pertence a"@pt .

:Contem a owl:ObjectProperty ;
    rdfs:domain :AreaOperacional ;
    rdfs:range :PropriedadeEmArea ;
    rdfs:label "contains"@en, "Contem"@pt .

:RefereSeA a owl:ObjectProperty ;
    rdfs:domain :PropriedadeEmArea ;
    rdfs:range :Estabelecimento ;
    rdfs:label "refers to"@en, "Refere-se a"@pt .

:VinculadaA a owl:ObjectProperty ;
    rdfs:domain :SubmissaoPropriedade ;
    rdfs:range :PropriedadeEmArea ;
    rdfs:label "linked to"@en, "Vinculada a"@pt .

:RealizadaPor a owl:ObjectProperty ;
    rdfs:domain :SubmissaoPropriedade ;
    rdfs:range :EquipeCampo ;
    rdfs:label "performed by"@en, "Realizada por"@pt .

:submissaoBarreiraHasBarreiraSanitaria a owl:ObjectProperty ;
    rdfs:domain :SubmissaoBarreira ;
    rdfs:range :BarreiraSanitaria ;
    rdfs:label "linked to barrier"@en .

:especieAnimalHasEstabelecimento a owl:ObjectProperty ;
    rdfs:domain :EspecieAnimal ;
    rdfs:range :Estabelecimento ;
    rdfs:label "explored in"@en .

:categoriaEspecieHasEspecieAnimal a owl:ObjectProperty ;
    rdfs:domain :CategoriaEspecie ;
    rdfs:range :EspecieAnimal ;
    rdfs:label "categorizes"@en .

:rastreamentoGpsHasVeiculo a owl:ObjectProperty ;
    rdfs:domain :RastreamentoGps ;
    rdfs:range :Veiculo ;
    rdfs:label "tracks vehicle"@en .

#################################################################
# Object properties — inverse and derived relations (axioms)
#################################################################

# AX-DEP-01: cycle belongs exclusively to one response
:cicloPertenceAResposta a owl:ObjectProperty ;
    owl:inverseOf :Possui ;
    rdfs:domain :CicloVigilancia ;
    rdfs:range :RespostaSanitaria ;
    rdfs:label "belongs to response"@en .

# AX-DEP-02: team belongs exclusively to one cycle
:equipeAlocadaEm a owl:ObjectProperty ;
    owl:inverseOf :Aloca ;
    rdfs:domain :EquipeCampo ;
    rdfs:range :CicloVigilancia ;
    rdfs:label "allocated to cycle"@en .

# AX-DEP-03: area belongs to a team
:areaDaEquipe a owl:ObjectProperty ;
    owl:inverseOf :AtuaEm ;
    rdfs:domain :AreaOperacional ;
    rdfs:range :EquipeCampo ;
    rdfs:label "belongs to team"@en .

# AX-DEP-04: property in area belongs to an operational area
:contidaEmArea a owl:ObjectProperty ;
    owl:inverseOf :Contem ;
    rdfs:domain :PropriedadeEmArea ;
    rdfs:range :AreaOperacional ;
    rdfs:label "contained in area"@en .

# AX-DEP-07: investigation target depends on an analysis
:alvoDeAnalise a owl:ObjectProperty ;
    owl:inverseOf :analiseSanitariaHasAlvoInvestigacao ;
    rdfs:domain :AlvoInvestigacao ;
    rdfs:range :AnaliseSanitaria ;
    rdfs:label "target of analysis"@en .

# AX-DEP-09: command post linked to at most one response
:postoDaResposta a owl:ObjectProperty ;
    owl:inverseOf :Tem ;
    rdfs:domain :PostoComando ;
    rdfs:range :RespostaSanitaria ;
    rdfs:label "command post of response"@en .

# AX-SEQ-02: zone belongs to a cycle
:zonaDoCiclo a owl:ObjectProperty ;
    owl:inverseOf :SubdivideSe ;
    rdfs:domain :ZonaPorCiclo ;
    rdfs:range :CicloVigilancia ;
    rdfs:label "zone of cycle"@en .

# AX-SEQ-02: area reachable from its cycle (area -> zone -> cycle)
:areaDoCiclo a owl:ObjectProperty ;
    rdfs:domain :AreaOperacional ;
    rdfs:range :CicloVigilancia ;
    owl:propertyChainAxiom ( :PertenceA :zonaDoCiclo ) ;
    rdfs:label "cycle of area"@en .

#################################################################
# Datatype properties — Core
#################################################################

:codigoEstabelecimento a owl:DatatypeProperty ;
    rdfs:domain :Estabelecimento ;
    rdfs:range xsd:string ;
    rdfs:label "SDA code"@en, "Codigo SDA"@pt .

:nomeEstabelecimento a owl:DatatypeProperty ;
    rdfs:domain :Estabelecimento ;
    rdfs:range xsd:string ;
    rdfs:label "establishment name"@en .

:tipoEstabelecimento a owl:DatatypeProperty ;
    rdfs:domain :Estabelecimento ;
    rdfs:range xsd:string ;
    rdfs:label "establishment type"@en .

:ativoEstabelecimento a owl:DatatypeProperty ;
    rdfs:domain :Estabelecimento ;
    rdfs:range xsd:boolean ;
    rdfs:label "active establishment"@en .

:codigoCar a owl:DatatypeProperty ;
    rdfs:domain :Estabelecimento ;
    rdfs:range xsd:string ;
    rdfs:label "CAR code"@en .

:geometriaCar a owl:DatatypeProperty ;
    rdfs:domain :Estabelecimento ;
    rdfs:range xsd:string ;
    rdfs:label "CAR geometry (WKT)"@en .

:rua a owl:DatatypeProperty ;
    rdfs:domain :Endereco ;
    rdfs:range xsd:string ;
    rdfs:label "street"@en, "Rua"@pt .

:cep a owl:DatatypeProperty ;
    rdfs:domain :Endereco ;
    rdfs:range xsd:string ;
    rdfs:label "postal code"@en, "CEP"@pt .

:numeroEndereco a owl:DatatypeProperty ;
    rdfs:domain :Endereco ;
    rdfs:range xsd:string ;
    rdfs:label "street number"@en .

:bairro a owl:DatatypeProperty ;
    rdfs:domain :Endereco ;
    rdfs:range xsd:string ;
    rdfs:label "district"@en, "Bairro"@pt .

:cidade a owl:DatatypeProperty ;
    rdfs:domain :Endereco ;
    rdfs:range xsd:string ;
    rdfs:label "city"@en, "Cidade"@pt .

:uf a owl:DatatypeProperty ;
    rdfs:domain :Endereco ;
    rdfs:range xsd:string ;
    rdfs:label "state"@en, "UF"@pt .

:latitude a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:label "latitude"@en .

:longitude a owl:DatatypeProperty ;
    rdfs:range xsd:double ;
    rdfs:label "longitude"@en .

:coordenadas a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "coordinates (WKT)"@en, "Coordenadas (WKT)"@pt ;
    rdfs:comment "AX-GEO-02: coordinates stored as WKT strings (PostGIS GEOGRAPHY at implementation level; consumed as WKT literals by GeoSPARQL queries)."@en .

:keycloakSubjectId a owl:DatatypeProperty ;
    rdfs:domain :Pessoa ;
    rdfs:range xsd:string ;
    rdfs:label "Keycloak subject id"@en .

:cpf a owl:DatatypeProperty ;
    rdfs:domain :Pessoa ;
    rdfs:range xsd:string ;
    rdfs:label "CPF"@en .

:nomePessoa a owl:DatatypeProperty ;
    rdfs:domain :Pessoa ;
    rdfs:range xsd:string ;
    rdfs:label "person name"@en .

:email a owl:DatatypeProperty ;
    rdfs:domain :Pessoa ;
    rdfs:range xsd:string ;
    rdfs:label "email"@en .

:dataCadastro a owl:DatatypeProperty ;
    rdfs:domain :Pessoa ;
    rdfs:range xsd:dateTime ;
    rdfs:label "registration date"@en .

:ativoPessoa a owl:DatatypeProperty ;
    rdfs:domain :Pessoa ;
    rdfs:range xsd:boolean ;
    rdfs:label "active person"@en .

:sistemaInspecao a owl:DatatypeProperty ;
    rdfs:domain :Frigorifico ;
    rdfs:range xsd:string ;
    rdfs:label "inspection system (SIF/SIE/SIM)"@en .

:numeroInspecao a owl:DatatypeProperty ;
    rdfs:domain :Frigorifico ;
    rdfs:range xsd:string ;
    rdfs:label "inspection number"@en .

:ativoFrigorifico a owl:DatatypeProperty ;
    rdfs:domain :Frigorifico ;
    rdfs:range xsd:boolean ;
    rdfs:label "active slaughterhouse"@en .

:finalidadeExploracao a owl:DatatypeProperty ;
    rdfs:domain :GranjaSuino ;
    rdfs:range xsd:string ;
    rdfs:label "exploration purpose"@en .

:integradora a owl:DatatypeProperty ;
    rdfs:domain :GranjaSuino ;
    rdfs:range xsd:string ;
    rdfs:label "integrator company"@en .

:registro a owl:DatatypeProperty ;
