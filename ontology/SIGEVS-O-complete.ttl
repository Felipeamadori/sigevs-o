# Datatype properties — Field Actions
#################################################################

:uuidSubmissao a owl:DatatypeProperty ;
    rdfs:domain :SubmissaoPropriedade ;
    rdfs:range xsd:string ;
    rdfs:label "submission uuid"@en .

:dadosSubmissao a owl:DatatypeProperty ;
    rdfs:domain :SubmissaoPropriedade ;
    rdfs:range xsd:string ;
    rdfs:label "submission data"@en .

:uuidSubmissaoBarreira a owl:DatatypeProperty ;
    rdfs:domain :SubmissaoBarreira ;
    rdfs:range xsd:string ;
    rdfs:label "barrier submission uuid"@en .

:dadosSubmissaoBarreira a owl:DatatypeProperty ;
    rdfs:domain :SubmissaoBarreira ;
    rdfs:range xsd:string ;
    rdfs:label "barrier submission data"@en .

:nomeContato a owl:DatatypeProperty ;
    rdfs:domain :PropriedadeTemporaria ;
    rdfs:range xsd:string ;
    rdfs:label "contact name"@en .

:cpfCnpj a owl:DatatypeProperty ;
    rdfs:domain :PropriedadeTemporaria ;
    rdfs:range xsd:string ;
    rdfs:label "CPF/CNPJ"@en .

:telefone a owl:DatatypeProperty ;
    rdfs:domain :PropriedadeTemporaria ;
    rdfs:range xsd:string ;
    rdfs:label "phone number"@en .

#################################################################
# Axioms — Identity (AX-ID-01..04)
#################################################################

# AX-ID-01: every Establishment has a unique SDA code
:Estabelecimento owl:hasKey ( :codigoEstabelecimento ) ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :codigoEstabelecimento ;
        owl:cardinality 1
    ] .

# AX-ID-02: Slaughterhouse existence depends on Establishment (covered by subClassOf)

# AX-ID-03: Person identified by keycloak id, CPF and email
:Pessoa owl:hasKey ( :keycloakSubjectId ) ;
    owl:hasKey ( :cpf ) ;
    owl:hasKey ( :email ) ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :keycloakSubjectId ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :cpf ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :email ;
        owl:cardinality 1
    ] .

# AX-ID-04: animal movement identified by (series, number, origin state)
:MovimentacaoAnimal owl:hasKey ( :serie :numeroGTA :ufOrigem ) ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :serie ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :numeroGTA ;
        owl:cardinality 1
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :ufOrigem ;
        owl:cardinality 1
    ] .

#################################################################
# Axioms — Dependency (AX-DEP-01..09)
#################################################################

# AX-DEP-01: Surveillance Cycle belongs exclusively to a Sanitary Response
:CicloVigilancia rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :cicloPertenceAResposta ;
    owl:cardinality 1
] .

# AX-DEP-02: Field Team belongs exclusively to a Surveillance Cycle
:EquipeCampo rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :equipeAlocadaEm ;
    owl:cardinality 1
] .

# AX-DEP-03: Operational Area belongs to a Field Team and a Zone per Cycle
:AreaOperacional rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :areaDaEquipe ;
    owl:cardinality 1
] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :PertenceA ;
        owl:cardinality 1
    ] .

# AX-DEP-04: Property in Area belongs to an Operational Area
:PropriedadeEmArea rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :contidaEmArea ;
    owl:cardinality 1
] .

# AX-DEP-05: Property Submission links to a Property in Area and a Field Team
:SubmissaoPropriedade rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :VinculadaA ;
    owl:cardinality 1
] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :RealizadaPor ;
        owl:cardinality 1
    ] .

# AX-DEP-06: Barrier Submission links to a Sanitary Barrier
:SubmissaoBarreira rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :submissaoBarreiraHasBarreiraSanitaria ;
    owl:cardinality 1
] .

# AX-DEP-07: Investigation Target depends on a Sanitary Analysis
:AlvoInvestigacao rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :alvoDeAnalise ;
    owl:cardinality 1
] .

# AX-DEP-08: Sanitary Response depends on a Sanitary Analysis
:RespostaSanitaria rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :BaseadaEm ;
    owl:cardinality 1
] .

# AX-DEP-09: Command Post linked to at most one Sanitary Response (and vice versa)
:RespostaSanitaria rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :Tem ;
    owl:maxCardinality 1
] .

:PostoComando rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :postoDaResposta ;
    owl:maxCardinality 1
] .

#################################################################
# Axioms — Sequence and Temporality (AX-SEQ-01..05)
#################################################################

# AX-SEQ-01: cycles follow sequential ordering within a response
:CicloVigilancia owl:hasKey ( :numeroCiclo :cicloPertenceAResposta ) ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :numeroCiclo ;
        owl:cardinality 1
    ] .

# AX-SEQ-02: a cycle can only be closed when all its areas are completed
:CicloFechado a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :CicloVigilancia
            [
                a owl:Restriction ;
                owl:onProperty :cicloFechado ;
                owl:hasValue true
            ]
        )
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :areaDoCiclo ;
        owl:allValuesFrom :AreaConcluida
    ] ;
    rdfs:label "Closed Surveillance Cycle"@en, "Ciclo de Vigilancia Fechado"@pt .

# AX-SEQ-03: an area is completed when all its properties are visited
:AreaConcluida a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :AreaOperacional
            [
                a owl:Restriction ;
                owl:onProperty :Contem ;
                owl:allValuesFrom :PropriedadeVisitada
            ]
            [
                a owl:Restriction ;
                owl:onProperty :Contem ;
                owl:minCardinality 1
            ]
        )
    ] ;
    rdfs:label "Completed Operational Area"@en, "Area Operacional Concluida"@pt .

:PropriedadeVisitada a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :PropriedadeEmArea
            [
                a owl:Restriction ;
                owl:onProperty :visitaConcluida ;
                owl:hasValue true
            ]
        )
    ] ;
    rdfs:label "Visited Property in Area"@en, "Propriedade em Area Visitada"@pt .

# AX-SEQ-04: a property in area can be reopened after completion (state transition)
:PropriedadeEmArea rdfs:comment "AX-SEQ-04: the visit status may transition from completed back to pending (reopen operation); modelled as a state transition, not as an OWL restriction."@en .

# AX-SEQ-05: GPS tracking has a start and an optional end
:RastreamentoGps rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :inicioRastreamento ;
    owl:cardinality 1
] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :fimRastreamento ;
        owl:maxCardinality 1
    ] .

#################################################################
# Axioms — Cardinality and Uniqueness (AX-CARD-01..05)
#################################################################

# AX-CARD-01: a person can only be summoned once for the same response
:PessoaConvocada owl:hasKey ( :keycloakSubjectId :Convoca ) .

# AX-CARD-02: an establishment can be the target of multiple simultaneous investigations
# (no uniqueness constraint between analysis and establishment — absence of restriction)

# AX-CARD-03: a team can have multiple members
:EquipeCampo rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :CompostaPor ;
    owl:minCardinality 1
] .

# AX-CARD-04: an establishment can be in multiple operational areas
# (no uniqueness constraint on premise + response in area_premises — absence of restriction)

# AX-CARD-05: a sanitary analysis can have multiple targets
:AnaliseSanitaria rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :analiseSanitariaHasAlvoInvestigacao ;
    owl:minCardinality 1
] .

#################################################################
# Axioms — State (AX-STATE-01..06)
#################################################################

# AX-STATE-01: a sanitary analysis can be active or inactive
:AnaliseSanitaria rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :analiseAtiva ;
    owl:cardinality 1
] .

# AX-STATE-02: a sanitary response can be active or completed
:RespostaSanitaria rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :respostaAtiva ;
    owl:cardinality 1
] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :respostaConcluida ;
        owl:cardinality 1
    ] .

# AX-STATE-03: a zone per cycle can be open or closed
:ZonaPorCiclo rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :zonaFechada ;
    owl:cardinality 1
] .

# AX-STATE-04: a property in area can be completed or pending
:PropriedadeEmArea rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :visitaConcluida ;
    owl:cardinality 1
] .

# AX-STATE-05: a summoned person can be in quarantine with an expiry date
:PessoaEmQuarentena a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :PessoaConvocada
            [
                a owl:Restriction ;
                owl:onProperty :emQuarentena ;
                owl:hasValue true
            ]
        )
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :quarentenaAte ;
        owl:cardinality 1
    ] ;
    rdfs:label "Person in Quarantine"@en, "Pessoa em Quarentena"@pt .

:PessoaConvocada rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :emQuarentena ;
    owl:cardinality 1
] .

# AX-STATE-06: a summoned person can have management and/or observer permissions
:PessoaConvocada rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :permissaoGestao ;
    owl:cardinality 1
] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty :permissaoObservacao ;
        owl:cardinality 1
    ] .

#################################################################
# Axioms — Geographic (AX-GEO-01..02)
#################################################################

# AX-GEO-01: an investigation target has up to three concentric zones
:AlvoInvestigacao rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :alvoInvestigacaoHasZonaControleInvestigacao ;
    owl:maxCardinality 3
] .

# AX-GEO-02: coordinates of targets and barriers are stored as WKT geometries
:AlvoInvestigacao rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :coordenadas ;
    owl:cardinality 1
] .

:BarreiraSanitaria rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :coordenadas ;
    owl:cardinality 1
] .
